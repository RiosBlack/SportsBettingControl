// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==================== AUTENTICAÇÃO ====================

model User {
  id            String    @id @default(cuid())
  authId        String?   @unique // Mantido para migração (opcional)
  name          String
  email         String    @unique
  password      String?   // Senha hasheada (opcional para OAuth)
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relacionamentos
  bankrolls       Bankroll[]
  bets            Bet[]
  favoriteLeagues FavoriteLeague[]
  favoriteTeams   FavoriteTeam[]

  @@map("users")
}

// ==================== GESTÃO DE BANCA ====================

model Bankroll {
  id             String   @id @default(cuid())
  userId         String
  name           String   @default("Banca Principal")
  initialBalance Decimal  @db.Decimal(10, 2)
  currentBalance Decimal  @db.Decimal(10, 2)
  currency       String   @default("BRL")
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Relacionamentos
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  bets         Bet[]
  transactions Transaction[]

  @@index([userId])
  @@map("bankrolls")
}

// ==================== MERCADOS ====================

model Market {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relacionamentos
  bets Bet[]

  @@map("markets")
}

// ==================== APOSTAS ====================

model Bet {
  id          String     @id @default(cuid())
  userId      String
  bankrollId  String
  // Informações da aposta
  sport       Sport      @default(FUTEBOL)
  event       String // Nome do evento (ex: "Flamengo x Palmeiras")
  competition String? // Campeonato/Liga
  marketId    String? // Referência ao mercado cadastrado (nullable temporariamente para migração)
  selection   String // Seleção escolhida (ex: "Flamengo", "Over 2.5", "Sim")
  odds        Decimal    @db.Decimal(10, 2) // Cotação da aposta
  stake       Decimal    @db.Decimal(10, 2) // Valor apostado
  // Status e resultado
  status      BetStatus  @default(PENDENTE)
  result      BetResult?
  profit      Decimal?   @db.Decimal(10, 2) // Lucro/Prejuízo
  // Datas
  eventDate   DateTime // Data do evento
  placedAt    DateTime   @default(now()) // Data em que a aposta foi feita
  settledAt   DateTime? // Data em que a aposta foi finalizada
  // Informações adicionais
  bookmaker   String? // Casa de apostas
  notes       String?    @db.Text // Observações sobre a aposta
  tags        String[] // Tags para categorização
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  // Relacionamentos
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  bankroll Bankroll @relation(fields: [bankrollId], references: [id], onDelete: Cascade)
  market   Market?  @relation(fields: [marketId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@index([bankrollId])
  @@index([marketId])
  @@index([status])
  @@index([sport])
  @@index([eventDate])
  @@map("bets")
}

// ==================== ENUMS ====================

enum Sport {
  FUTEBOL
  BASQUETE
  TENIS
  VOLEI
  FUTSAL
  HANDEBOL
  BASEBALL
  FUTEBOL_AMERICANO
  HOCKEY
  MMA
  BOXE
  ESPORTS
  OUTROS
}

enum BetStatus {
  PENDENTE // Aguardando resultado
  GANHA // Aposta vencedora
  PERDIDA // Aposta perdida
  ANULADA // Aposta cancelada/devolvida
  CASHOUT // Encerrada antecipadamente
}

enum BetResult {
  WIN // Ganhou
  LOSS // Perdeu
  VOID // Anulada
  HALF_WIN // Meia vitória (Asian Handicap)
  HALF_LOSS // Meia derrota (Asian Handicap)
}

// ==================== JOGOS DO DIA ====================

model Team {
  id        String   @id @default(cuid())
  apiId     Int      @unique // ID da API (API-Football ou API-Sports)
  name      String
  logo      String?
  sport     Sport    @default(FUTEBOL)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relacionamentos
  homeMatches        Match[]              @relation("HomeTeam")
  awayMatches        Match[]              @relation("AwayTeam")
  favoriteTeams      FavoriteTeam[]
  matchStatistics    MatchTeamStatistic[] @relation("TeamStats")
  opponentStatistics MatchTeamStatistic[] @relation("OpponentStats")
  teamStatsSyncs     TeamStatsSync[]

  @@index([sport])
  @@index([apiId])
  @@map("teams")
}

model League {
  id        String   @id @default(cuid())
  apiId     Int      @unique // ID da API
  name      String
  logo      String?
  country   String?
  sport     Sport    @default(FUTEBOL)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relacionamentos
  matches         Match[]
  favoriteLeagues FavoriteLeague[]
  teamStatsSyncs  TeamStatsSync[]

  @@index([sport])
  @@index([apiId])
  @@map("leagues")
}

model Match {
  id         String   @id @default(cuid())
  apiId      Int      @unique // ID da API
  sport      Sport    @default(FUTEBOL)
  date       DateTime @db.Date
  time       String? // Horário local (HH:mm)
  utcDate    DateTime // Data/hora UTC
  status     String // NS, LIVE, FT, etc.
  season     Int?
  // Scores
  homeScore  Int?
  awayScore  Int?
  // Relacionamentos
  homeTeamId String
  awayTeamId String
  leagueId   String
  // Timestamps
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // Relacionamentos
  homeTeam    Team                 @relation("HomeTeam", fields: [homeTeamId], references: [id], onDelete: Cascade)
  awayTeam    Team                 @relation("AwayTeam", fields: [awayTeamId], references: [id], onDelete: Cascade)
  league      League               @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  teamStats   MatchTeamStatistic[]

  @@index([sport])
  @@index([date])
  @@index([status])
  @@index([apiId])
  @@index([season])
  @@map("matches")
}

// ==================== ESTATÍSTICAS DE CLUBES ====================

model MatchTeamStatistic {
  id             String   @id @default(cuid())
  matchId        String
  teamId         String
  opponentTeamId String
  leagueId       String
  season         Int
  isHome         Boolean
  stats          Json
  derived        Json
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  match        Match @relation(fields: [matchId], references: [id], onDelete: Cascade)
  team         Team  @relation("TeamStats", fields: [teamId], references: [id], onDelete: Cascade)
  opponentTeam Team  @relation("OpponentStats", fields: [opponentTeamId], references: [id], onDelete: Cascade)

  @@unique([matchId, teamId])
  @@index([teamId])
  @@index([matchId])
  @@index([leagueId])
  @@index([season])
  @@map("match_team_statistics")
}

model TeamStatsSync {
  id            String   @id @default(cuid())
  teamId        String
  leagueId      String
  season        Int
  lastMatchDate DateTime @db.Date
  syncedAt      DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  team   Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)
  league League @relation(fields: [leagueId], references: [id], onDelete: Cascade)

  @@unique([teamId, leagueId, season])
  @@index([teamId])
  @@index([leagueId])
  @@map("team_stats_syncs")
}

model FixtureSync {
  id        String   @id @default(cuid())
  date      DateTime @unique @db.Date
  syncedAt  DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("fixture_syncs")
}

// ==================== TRANSAÇÕES DE BANCA ====================

enum TransactionType {
  DEPOSIT  // Depósito (entrada)
  WITHDRAW // Saque (saída)
}

model Transaction {
  id          String          @id @default(cuid())
  bankrollId  String
  type        TransactionType
  amount      Decimal         @db.Decimal(10, 2)
  description String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  // Relacionamentos
  bankroll Bankroll @relation(fields: [bankrollId], references: [id], onDelete: Cascade)

  @@index([bankrollId])
  @@index([type])
  @@index([createdAt])
  @@map("transactions")
}

// ==================== FAVORITOS ====================

model FavoriteLeague {
  id        String   @id @default(cuid())
  userId    String
  leagueId  String
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  league League @relation(fields: [leagueId], references: [id], onDelete: Cascade)

  @@unique([userId, leagueId])
  @@index([userId])
  @@index([leagueId])
  @@map("favorite_leagues")
}

model FavoriteTeam {
  id        String   @id @default(cuid())
  userId    String
  teamId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([userId, teamId])
  @@index([userId])
  @@index([teamId])
  @@map("favorite_teams")
}
